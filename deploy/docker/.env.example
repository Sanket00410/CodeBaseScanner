# CodeSentinelX Enterprise — required secrets for docker-compose.enterprise.yml
PG_PASSWORD=change_me_generate_a_long_random_string
REDIS_PASSWORD=change_me_generate_a_long_random_string
ES_PASSWORD=change_me_generate_a_long_random_string
RABBITMQ_PASSWORD=change_me_generate_a_long_random_string
ZK_PASSWORD=change_me_generate_a_long_random_string
KAFKA_PASSWORD=change_me_generate_a_long_random_string

# Optional overrides
PG_USER=codesentinel
PG_PORT=5432
REDIS_PORT=6379
ES_PORT=9200
RABBITMQ_PORT=5672
ZK_PORT=2181
KAFKA_PORT=9092
