{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-main",
    "types": ["node", "electron"],
    "rootDir": "."
  },
  "include": [
    "electron/**/*.ts",
    "backend/**/*.ts",
    "database/**/*.ts"
  ]
}
